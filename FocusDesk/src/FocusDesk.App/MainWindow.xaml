<Window x:Class="FocusDesk.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/FocusDesk.ico" Title="FocusDesk — пространство для важных дел" Width="1280" Height="850" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Grid Background="#F6F6FA">
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="#E8E7F0" BorderThickness="0,0,1,0">
   <DockPanel Margin="20,26,20,18">
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,35"><StackPanel Orientation="Horizontal"><Border Background="#7160D5" CornerRadius="10" Width="34" Height="34"><TextBlock Text="f" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-3,0,0"/></Border><TextBlock Text="FocusDesk" FontSize="22" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Меньше шума. Больше фокуса." FontSize="11" Foreground="#89889A" Margin="0,13,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Border Background="#F4F1FD" CornerRadius="12" Padding="14" Margin="0,0,0,18"><StackPanel><TextBlock Text="Один шаг за раз" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Выбери важную задачу и начни с 25 минут." Foreground="#7A728D" FontSize="12" Margin="0,7,0,0"/></StackPanel></Border>
     <TextBlock Text="●  Локальное пространство" Foreground="#6E8C7C" FontSize="11"/><TextBlock Text="Твои планы — на твоём компьютере" Foreground="#A1A0AE" FontSize="10" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel x:Name="Navigation"/>
   </DockPanel>
  </Border>
  <DockPanel Grid.Column="1">
   <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E8E7F0" BorderThickness="0,0,0,1" Padding="30,16"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Border Background="#F0EDF9" CornerRadius="15" Padding="11,5"><TextBlock x:Name="MiniTimer" Text="Твоё время для важного" FontSize="12" Foreground="#7160D5"/></Border></StackPanel><TextBlock x:Name="Breadcrumb" Text="Рабочее пространство / Сегодня" Foreground="#888699" FontSize="12" VerticalAlignment="Center"/></DockPanel></Border>
   <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#E8E7F0" Padding="30,10"><TextBlock x:Name="StatusLine" Text="Готово к работе · данные сохраняются автоматически" Foreground="#878596" FontSize="11" TextTrimming="CharacterEllipsis"/></Border>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Page" Margin="30,28,30,24"/></ScrollViewer>
  </DockPanel>
 </Grid>
</Window>
